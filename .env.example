# Swing Society web — environment template
# Copy to .env (gitignored) and fill in. Never commit real values.
# Every variable is optional for local dev; missing ones fall back to config.json / defaults.

# --- Runtime ---------------------------------------------------------------
# development | production  (production forces host 0.0.0.0 and locks CORS origins)
ENVIRONMENT=development
HOST=localhost
PORT=8080
# Path to config.json (defaults to ./config.json)
CONFIG_PATH=
# Set to "true" inside the Docker image (root dir becomes /app)
DOCKER_CONTAINER=

# --- Google Cloud / Firebase ----------------------------------------------
GOOGLE_CLOUD_PROJECT=swingsociety-backend
# Local dev only: the full service-account JSON on ONE line (not a file path).
# On Cloud Run leave empty — the ss-go1 service account authenticates via ADC.
GOOGLE_CREDENTIALS=
# Legacy fallback used by the calendar client when GOOGLE_CREDENTIALS is empty.
FIREBASE_CREDENTIALS_FILE=

# --- Google Calendar / Sheets ---------------------------------------------
GOOGLE_CALENDAR_ID=
# Published-to-web CSV URL of the content sheet (overrides config.json)
GOOGLE_SHEETS_CSV_URL=

# --- Email (SMTP) — email is disabled unless HOST, USER and PASS are all set --
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where contact / registration notifications are delivered
RECIPIENT_EMAIL=
